# Copy this to `.env` in the project root before running `docker compose up`.
# docker-compose.yml reads env vars from `.env` automatically.
#
# DATABASE_URL and WHISPER_API_URL are set inside the compose file itself
# (web service points at the `db` and `whisper` services on the compose
# network). The values below are knobs the user might want to tweak.

# Required from Step 4 onward (cleanup + topic segmentation).
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Transcription engine.
#   "python" → faster-whisper running in the `whisper` compose service
#              (free, downloads model on first run, cached after that)
#   "openai" → OpenAI Whisper API (paid, $0.006/min, faster start since
#              no model download)
TRANSCRIBE_PROVIDER=python

# faster-whisper model. Used by the whisper service. Smaller = faster +
# less accurate, larger = slower + more accurate. Downloaded on first
# run to /root/.cache/huggingface (cached in the `whisper-cache` named
# volume so subsequent runs skip the download).
#   tiny.en   ~75 MB    fastest
#   base.en   ~150 MB   recommended default
#   small.en  ~480 MB
#   medium.en ~1.5 GB
#   large-v3  ~3 GB     slowest, most accurate
WHISPER_PYTHON_MODEL=base.en

# Threads for faster-whisper inside the whisper service. Tune to your
# host CPU. Higher = faster but more contention if other things share
# the box.
FW_CPU_THREADS=4

# Per-video Whisper chunk concurrency on the Node side. The web
# container fires up to this many parallel HTTP /transcribe calls
# against the whisper service. Each call holds the whisper service's
# GIL while running, so going much above 4 yields diminishing returns.
WHISPER_PYTHON_PARALLEL=auto

# Cross-child cascade on the OpenAI side (clean + split). 3 keeps you
# under OpenAI rate limits on a free-tier key.
WHISPER_CONCURRENCY=3

# ─── Step 6 HeyGen avatar render ─────────────────────────────────────
# Required to enable Step 6 with renderStyle="instructor". The pipeline
# uses HeyGen's Talking-Photo API: the uploaded instructor photo (Step
# 6 photo dropzone) is sent to HeyGen, and each canonical planet chunk's
# enriched script is rendered into a per-chunk mp4.
#
# Get a key at https://app.heygen.com/settings/api-keys. When unset,
# Step 6's "Generate all" button returns a 503 with a helpful message.
HEYGEN_API_KEY=

# HeyGen voice_id for the avatar narration. Browse the list of available
# voices at https://docs.heygen.com/reference/list-voices-v2 or via
# `curl https://api.heygen.com/v2/voices -H "X-Api-Key: $HEYGEN_API_KEY"`.
# When unset we fall back to the default in render/route.ts:DEFAULT_VOICE_ID.
HEYGEN_DEFAULT_VOICE_ID=

# ─── Step 5 script polish (Pass 4) ───────────────────────────────────
# Pass 4 produces a polished "enriched script" for each canonical
# planet by running its raw transcript through GPT-4o. Step 6 (HeyGen)
# sends the polished script to the avatar instead of the raw words
# from the lecturer.
#
# Tavily web search was removed — we now use OpenAI exclusively so
# there's no extra API key required. The polish pass uses the
# existing OPENAI_API_KEY above.
#
# Parallel enrichment calls per video. Each call is one GPT-4o
# synthesis. Default 3 is safe under tier-1 rate limits; bump higher
# on tier-2+ keys.
ENRICH_CONCURRENCY=3
